<Window x:Class="MailTemplater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mail Şablonları" Icon="Assets/app.ico" Icon="Assets/app.ico" Height="720" Width="1000" MinHeight="600" MinWidth="860">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol: bırakma alanı + liste -->
        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Height="110" AllowDrop="True" BorderBrush="#888" BorderThickness="2"
                    CornerRadius="8" Background="#F5F8FF" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter">
                <TextBlock Text="Maili buraya sürükleyip bırakın&#10;(Outlook / .msg / .eml)" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="#555"/>
            </Border>
            <Button DockPanel.Dock="Top" Content="+ Yeni boş şablon" Margin="0,8" Padding="6" Click="New_Click"/>
            <ListBox x:Name="TemplateList" DisplayMemberPath="Name" SelectionChanged="TemplateList_SelectionChanged"/>
        </DockPanel>

        <!-- Sağ: düzenleme -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Şablon adı"/><TextBox x:Name="NameBox" Margin="0,2,0,8"/>
                <TextBlock Text="Kime (To) — ; ile ayırın"/><TextBox x:Name="ToBox" Margin="0,2,0,8"/>
                <TextBlock Text="CC"/><TextBox x:Name="CcBox" Margin="0,2,0,8"/>
                <TextBlock Text="BCC"/><TextBox x:Name="BccBox" Margin="0,2,0,8"/>
                <TextBlock Text="Konu"/><TextBox x:Name="SubjectBox" Margin="0,2,0,8"/>
                <CheckBox x:Name="HtmlCheck" Content="İçerik HTML" Margin="0,0,0,4"/>
                <TextBlock Text="İçerik"/>
                <TextBox x:Name="BodyBox" Height="200" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,2,0,8"/>
                <TextBlock Text="Ekler"/>
                <ListBox x:Name="AttachList" Height="80" Margin="0,2,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Ek ekle…" Padding="8,3" Click="AddAttach_Click"/>
                    <Button Content="Seçili eki sil" Padding="8,3" Margin="6,0,0,0" Click="RemoveAttach_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Kaydet" Padding="14,6" Click="Save_Click"/>
                    <Button Content="Sil" Padding="14,6" Margin="6,0,0,0" Click="Delete_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Klasik Outlook'ta aç" Padding="12,6" Click="OpenClassic_Click"/>
                    <Button Content="Yeni Outlook'ta aç (Graph)" Padding="12,6" Margin="6,0,0,0" Click="OpenNew_Click"/>
                </StackPanel>

                <TextBlock Text="Azure Client ID (yalnızca yeni Outlook için)" Margin="0,14,0,0" Foreground="#666"/>
                <TextBox x:Name="ClientIdBox" Margin="0,2,0,0" LostFocus="ClientId_LostFocus"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
