<Window x:Class="MailTemplater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Mail Şablonları" Icon="Assets/app.ico"
        Height="800" Width="1200" MinHeight="680" MinWidth="1000"
        Background="{StaticResource AppBgBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SOL PANEL ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="20,22,20,20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,22">
                    <Image Source="Assets/app.ico" Width="42" Height="42"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mail Şablonları" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Tek tıkla hazır mail" Foreground="#94A3B8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bırakma alanı -->
                <Border x:Name="DropZone" DockPanel.Dock="Top" Height="132" CornerRadius="16" AllowDrop="True"
                        Background="{StaticResource DropIdleBrush}"
                        DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver"
                        DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                    <Grid IsHitTestVisible="False">
                        <Rectangle x:Name="DropOutline" RadiusX="16" RadiusY="16" Margin="1"
                                   Stroke="{StaticResource OutlineIdleBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                       Foreground="#60A5FA" HorizontalAlignment="Center"/>
                            <TextBlock Text="Maili buraya bırakın" Foreground="White" FontWeight="SemiBold"
                                       FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="Outlook, .msg veya .eml" Foreground="#94A3B8" FontSize="11.5"
                                       Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button DockPanel.Dock="Top" Style="{StaticResource SidebarButton}" Margin="0,14,0,18" Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Yeni boş şablon"/>
                    </StackPanel>
                </Button>

                <TextBlock DockPanel.Dock="Top" Text="ŞABLONLARIM" Foreground="#64748B" FontSize="11"
                           FontWeight="Bold" Margin="4,0,0,8"/>

                <ListBox x:Name="TemplateList" Style="{StaticResource SidebarList}"
                         SelectionChanged="TemplateList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"
                                           FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subject}" Foreground="#CBD5E1" FontSize="11.5"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== SAĞ ALAN ===== -->
        <Grid Grid.Column="1" Margin="28,22,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sil"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kaydet"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="ŞABLON ADI" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" FontSize="20" FontWeight="Bold" Padding="10,6"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>

                    <!-- Alıcılar ve konu -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Alıcılar ve konu" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                            <TextBlock Text="KİME (TO)  ·  birden fazlası için ; kullanın" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ToBox" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CC" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CcBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="BCC" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BccBox"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="KONU" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SubjectBox"/>
                        </StackPanel>
                    </Border>

                    <!-- İçerik -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="HtmlCheck" Content="İçerik HTML" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="HTML'i düz metne çevir" Style="{StaticResource AccentGhostButton}"
                                            Padding="12,6" FontSize="12" Click="ToPlain_Click"/>
                                </StackPanel>
                                <TextBlock Text="İçerik" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="B" FontWeight="Bold" Style="{StaticResource ToolButton}" Focusable="False" Click="Bold_Click"/>
                                <Button Content="I" FontStyle="Italic" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Focusable="False" Click="Italic_Click"/>
                                <Button Content="U" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Focusable="False" Click="Underline_Click"/>
                                <TextBlock Text="Önizleme sekmesinde doğrudan yazıp düzenleyebilirsiniz" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <TabControl x:Name="BodyTabs" Height="300" SelectionChanged="BodyTabs_SelectionChanged">
                                <TabItem Header="Önizleme / düzenle">
                                    <wv2:WebView2 x:Name="Preview"/>
                                </TabItem>
                                <TabItem Header="Düz metin / kaynak">
                                    <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             FontFamily="Consolas" BorderThickness="0" Background="Transparent"/>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>

                    <!-- Ekler -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12" Click="AddAttach_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ek ekle"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Seçili eki sil" Style="{StaticResource DangerButton}" Padding="12,6" FontSize="12"
                                            Margin="8,0,0,0" Click="RemoveAttach_Click"/>
                                </StackPanel>
                                <TextBlock Text="Ekler" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox x:Name="AttachList" Style="{StaticResource LightList}" Height="96">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,3">
                                            <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Ayarlar -->
                    <Border Style="{StaticResource Card}">
                        <Expander Header="Yeni Outlook (Graph) ayarı" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="AZURE CLIENT ID" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ClientIdBox" FontWeight="Normal" LostFocus="ClientId_LostFocus"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Alt çubuk -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Margin="-28,0,-28,0" Padding="28,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Şablonu seçili mail programında açıp tüm alanları doldurur"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource AccentGhostButton}" Click="OpenNew_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Yeni Outlook'ta aç"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Click="OpenClassic_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Klasik Outlook'ta aç"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
